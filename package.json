{
  "name": "beyond-site-v1",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "predev": "node scripts/figma/prepare-artwork.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 4173",
    "prebuild": "node scripts/figma/prepare-artwork.mjs --clean-export",
    "build": "next build",
    "test": "node --test scripts/figma/*.test.mjs scripts/tests/*.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\"",
    "css:check": "node scripts/css/check-cascade.mjs",
    "css:fix": "node scripts/css/check-cascade.mjs --fix",
    "start": "serve out --listen tcp://127.0.0.1:4173 --no-clipboard --no-port-switching",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@xmldom/xmldom": "^0.9.12",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "wawoff2": "^2.0.1"
  }
}
